---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Terminal Not Found // Tony Khawaja-Lopez">
  <div class="flex flex-col items-center justify-center min-h-[60vh] gap-6 p-8">
    <div class="text-primary-container font-bold text-5xl md:text-7xl tracking-widest">
      404
    </div>
    <div class="text-on-surface/70 font-mono text-sm md:text-base">
      ERROR: ROUTE_NOT_FOUND
    </div>
    <pre class="text-error text-xs md:text-sm leading-relaxed text-center max-w-md" aria-hidden="true">
  ┌──────────────────────────────┐
  │  The requested path does not │
  │  exist in the current        │
  │  filesystem.                 │
  │                              │
  │  Try:                        │
  │  • <a href="/" class="underline hover:text-white">cd /</a> to return to root  │
  └──────────────────────────────┘
    </pre>
    <a
      href="/"
      class="mt-4 inline-block border border-primary-container text-primary-container px-6 py-2 font-mono text-sm uppercase tracking-widest hover:bg-primary-container hover:text-black transition-colors"
    >
      Return to Terminal
    </a>
  </div>
</Layout>
